<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/imagePokemon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/pokemon_image"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/pikachu" />

    <TextView
        android:id="@+id/textNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:includeFontPadding="false"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/imageChevron"
        app:layout_constraintStart_toEndOf="@id/imagePokemon"
        app:layout_constraintTop_toTopOf="@id/imagePokemon"
        tools:text="#025" />

    <TextView
        android:id="@+id/textName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/textNumber"
        app:layout_constraintStart_toStartOf="@id/textNumber"
        app:layout_constraintTop_toBottomOf="@id/textNumber"
        tools:text="Pikachu" />

    <LinearLayout
        android:id="@+id/typesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/textNumber"
        app:layout_constraintStart_toStartOf="@id/textNumber"
        app:layout_constraintTop_toBottomOf="@id/textName"
        tools:layout_height="20dp" />

    <ImageView
        android:id="@+id/imageChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/navigate_to_details"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/textNumber"
        app:layout_constraintTop_toBottomOf="@id/typesContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
